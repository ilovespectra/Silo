Options -Indexes
DirectoryIndex index.html index.php
RewriteEngine On

# Keep credentials and dotfiles out of the web root if they are misplaced.
RewriteRule ^(?:private(?:/|$)|\.) - [F,L,NC]
RewriteRule ^(?:api/health|api/license/claim-legacy|api/purchase(?:/[0-9a-f-]{36})?)/?$ index.php [QSA,L,NC]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
