# Copy to .env and fill in values from https://console.cloud.google.com/apis/credentials
# See README "Connecting Google Drive and Google Photos" for the full walkthrough.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback

# Electron renders the UI itself, so the dev server should not open a browser tab.
BROWSER=none
