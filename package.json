{
  "name": "silo",
  "version": "2.3.8",
  "description": "A local-first media library with semantic search, people, maps, messages, and duplicate management.",
  "main": "electron-dist/main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron-dist.cjs",
    "react-start": "PORT=8787 react-scripts start",
    "react-build": "react-scripts build && node scripts/lockdown-built-csp.cjs",
    "react-test": "react-scripts test",
    "test:auto-indexing": "node test/runAutoIndexingTests.cjs",
    "test:cache-destinations": "node test/runCacheDestinationTests.cjs",
    "test:semantic-isolation": "node test/runSemanticIsolationTests.cjs",
    "search-eval": "node scripts/search-eval.cjs",
    "test:search-eval": "node test/search-eval-core.test.cjs",
    "test:face-clustering": "node test/runFaceClusteringTests.cjs",
    "test:borrowed-locations": "node test/runBorrowedLocationTests.cjs",
    "test:message-coverage": "node test/runMessageCoverageTests.cjs",
    "test:ios-message-backup": "node test/runIosMessageBackupTests.cjs",
    "test:beta-license": "npm run test:license",
    "test:lifetime-payment": "npm run test:license",
    "test:owner-license": "npm run test:license",
    "owner:keys": "node scripts/owner-license.cjs init",
    "owner:grant": "node scripts/owner-license.cjs grant",
    "release:check": "npm run test:license && npm run test:mac-update-manifest && npm run test:app-assets && node scripts/check-beta-release.cjs",
    "react-eject": "react-scripts eject",
    "electron-start": "node scripts/brand-dev-app.js --quiet && wait-on http://localhost:8787 && electron .",
    "start": "concurrently -k \"npm run react-start\" \"npm run electron-start\"",
    "build": "npm run react-build && tsc",
    "eject": "react-scripts eject",
    "dev": "node scripts/dev.cjs",
    "beta:keys": "node scripts/beta-license.cjs init",
    "beta:grant": "node scripts/beta-license.cjs grant",
    "brand-dev": "node scripts/brand-dev-app.js",
    "unbrand-dev": "node scripts/brand-dev-app.js --restore",
    "dist": "npm run react-build && tsc && npm run release:check && electron-builder --config config/packaging/electron-builder.config.cjs",
    "dist:mac:x64": "node scripts/dist-mac.cjs x64",
    "dist:mac:arm64": "node scripts/dist-mac.cjs arm64",
    "release:merge-mac-updates": "node scripts/merge-mac-update-manifests.cjs",
    "test:mac-update-manifest": "node test/runMacUpdateManifestTests.cjs",
    "test:clone-archive": "node test/runCloneArchiveTests.cjs && node test/runSourceCloneTests.cjs && node test/runShelterVerificationTests.cjs",
    "test:ffmpeg-packaging": "node test/runFfmpegPackagingTests.cjs",
    "test:phone-restore-target": "node test/runPhoneRestoreTargetTests.cjs",
    "test:startup-smoke": "node test/runStartupSmokeTests.cjs",
    "test:portable-storage": "node test/runPortableStorageTests.cjs && node test/runConfigBundleRestoreTests.cjs && node test/runPhoneRestoreTargetTests.cjs && node test/runOfflinePhoneBackupTests.cjs",
    "test:progress-throttle": "node test/runProgressThrottleTests.cjs",
    "test:app-assets": "node test/runAppAssetsTests.cjs",
    "repackage_binaries": "node scripts/repackage-binaries.cjs",
    "test:license": "node test/runLifetimePaymentTests.cjs && node --check scripts/beta-license.cjs && node --check scripts/check-beta-release.cjs && node --check scripts/owner-license.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "archiver": "^7.0.1",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "globe.gl": "^2.46.2",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "mime": "^3.0.0",
    "music-metadata": "11.16.0",
    "numkong": "7.8.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.13.0",
    "qrcode.react": "^4.2.0",
    "react-markdown": "^8.0.7",
    "remark-gfm": "^3.0.1",
    "sharp": "^0.35.5",
    "tar-stream": "^3.2.2",
    "three": "^0.180.0",
    "usearch": "2.26.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.12.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^8.2.0",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.solosilo.app",
    "productName": "Silo",
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "CFBundleName": "Silo",
        "CFBundleDisplayName": "Silo",
        "NSDesktopFolderUsageDescription": "Silo needs access to browse and index files on your Desktop.",
        "NSDocumentsFolderUsageDescription": "Silo needs access to browse and index files in your Documents.",
        "NSDownloadsFolderUsageDescription": "Silo needs access to browse and index files in your Downloads.",
        "NSRemovableVolumesUsageDescription": "Silo needs access to read Time Machine backups and files on external drives.",
        "NSNetworkVolumesUsageDescription": "Silo needs access to read backups and files on network volumes.",
        "NSPhotoLibraryUsageDescription": "Silo needs access to read photos you choose to browse."
      },
      "icon": "public/icon.icns"
    },
    "files": [
      "build/**/*",
      "electron-dist/**/*",
      "public/preload.js",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jspi.*",
      "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.*"
    ],
    "protocols": [
      {
        "name": "Silo lifetime beta activation",
        "schemes": [
          "silo"
        ]
      }
    ],
    "extraResources": [
      {
        "from": ".model-test-cache",
        "to": "clip-model-cache"
      },
      {
        "from": "node_modules/@vladmandic/face-api/model",
        "to": "face-models"
      },
      {
        "from": "vendor/phone-tools/${platform}-${arch}",
        "to": "phone-tools",
        "filter": [
          "**/*",
          "!.silo-phone-tools"
        ]
      },
      {
        "from": "node_modules/@tensorflow/tfjs-backend-wasm/dist",
        "to": "face-wasm",
        "filter": [
          "*.wasm"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-web/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/usearch/prebuilds/**/*",
      "node_modules/numkong/**/*",
      "node_modules/@numkong/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "icon": "public/icon.png"
    },
    "linux": {
      "icon": "public/icon.png"
    }
  },
  "productName": "Silo",
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "^2.0.1"
    },
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "underscore": "^1.13.8"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.35.5"
  }
}
